# ── Database ──
# Option A — Docker local (run: npm run docker:up):
DATABASE_URL=postgresql://brightpath:brightpath_dev@localhost:5433/brightpath
#
# Option B — Free cloud Postgres (Neon https://neon.tech or Supabase):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/brightpath?sslmode=require

# ── Redis (Docker local) ──
REDIS_URL=redis://localhost:6380

# ── API ──
API_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
# Comma-separated origins, or omit to allow any http://localhost:<port> in dev
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Optional absolute origin for video URLs in teacher review modal (Express, not Vite)
# API_BASE_URL=http://localhost:3001
# API_PUBLIC_URL=http://localhost:3001

# Optional: system Chrome/Chromium binary for Remotion (avoids chrome-headless-shell libnspr4 crashes)
# CHROME_PATH=/usr/bin/google-chrome-stable
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium-browser

# ── Phase 1 — LLM tutor (set one provider) ──
# Google Gemini (recommended): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# On HTTP 503 / high demand the API cycles:
#   gemini-2.5-flash → gemini-2.5-pro → gemini-1.5-flash → other discovered models
#
# OpenAI (alternative if no Gemini key):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ── Voice (ElevenLabs STT + TTS; Google TTS fallback on 402) ──
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Free premade voices only (Sarah / Rachel). Do NOT use Instant Voice Clone IDs.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
