# ── Database ──
# Option A — Docker local (run: npm run docker:up):
DATABASE_URL=postgresql://brightpath:brightpath_dev@localhost:5433/brightpath
#
# Option B — Free cloud Postgres (Neon https://neon.tech or Supabase):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/brightpath?sslmode=require

# ── Redis (Docker local) ──
REDIS_URL=redis://localhost:6380

# ── API ──
API_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
# Comma-separated origins, or omit to allow any http://localhost:<port> in dev
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Vite proxy — use /api (do NOT use localhost:3001 unless api runs with CORS)
VITE_API_URL=/api

# ── Phase 1+ (add when implementing) ──
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
