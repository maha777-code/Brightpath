generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgeGroup {
  TODDLER_1_3
  EARLY_4_7
  UPPER_ELEM_8_10
  MIDDLE_11_14
}

enum ModuleStatus {
  COMPLETED
  IN_PROGRESS
  UNLOCKED
  LOCKED
}

model Parent {
  id                     String               @id @default(cuid())
  email                  String               @unique
  passwordHash           String
  name                   String?
  locale                 String               @default("en-IN")
  dateOfBirth            DateTime?
  calculatedAgeGroup     AgeGroup?
  unlockedSubjects       String[]             @default([])
  currentStreak          Int                  @default(0)
  longestStreak          Int                  @default(0)
  lastActiveDate         DateTime?
  timeStudiedThisWeek    Int                  @default(0)
  lastWeekResetTimestamp DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  children               Child[]
  moduleProgress         UserModuleProgress[]
  skillMastery           UserSkillMastery[]
  goals                  UserGoal[]
  videoProgress          UserVideoProgress[]
  quizResults            UserQuizResult[]
  chapterProgress        UserChapterProgress[]
  platformUsers          PlatformUser[]
}

model Child {
  id                 String   @id @default(cuid())
  parentId           String
  parent             Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name               String
  age                Int
  ageBand            String
  dateOfBirth        DateTime?
  calculatedAgeGroup AgeGroup @default(EARLY_4_7)
  unlockedSubjects   String[] @default([])
  subjects           String[]
  locale             String   @default("en-IN")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([parentId])
}

model ModuleNode {
  id                  String               @id @default(cuid())
  title               String
  ageGroup            AgeGroup
  sequenceOrder       Int
  prerequisiteNodeIds String[]             @default([])
  subjectCategory     String
  /** Optional deep-link into existing lesson UI, e.g. /learn/reading */
  learnRoute          String?
  /** For adaptive remediation review modules */
  isReview            Boolean              @default(false)
  reviewOfNodeId      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  progress            UserModuleProgress[]

  @@index([ageGroup, sequenceOrder])
  @@unique([ageGroup, title, sequenceOrder])
}

model UserModuleProgress {
  id              String       @id @default(cuid())
  userId          String
  user            Parent       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId          String
  node            ModuleNode   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  status          ModuleStatus @default(LOCKED)
  masteryScore    Int          @default(0)
  needsRemediation Boolean     @default(false)
  lastAttemptedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, nodeId])
  @@index([userId])
  @@index([nodeId])
}

/** Age-group subject shown in "My Subjects" (catalog, not lesson Subject enum) */
model SubjectCatalog {
  id          String      @id @default(cuid())
  /** Stable slug e.g. early_reading */
  slug        String
  name        String
  ageGroup    AgeGroup
  colorTheme  String
  learnRoute  String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  skills      SkillNode[]
  chapters    Chapter[]

  @@unique([ageGroup, slug])
  @@index([ageGroup, sortOrder])
  @@map("subjects")
}

model Chapter {
  id            String                @id @default(cuid())
  subjectId     String
  subject       SubjectCatalog        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title         String
  sequenceOrder Int
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  videos        VideoLesson[]
  quiz          ChapterQuiz?
  userProgress  UserChapterProgress[]
  quizResults   UserQuizResult[]

  @@unique([subjectId, sequenceOrder])
  @@index([subjectId])
}

model VideoLesson {
  id                String              @id @default(cuid())
  chapterId         String
  chapter           Chapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title             String
  videoUrl          String
  durationInSeconds Int
  sequenceOrder     Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  progress          UserVideoProgress[]

  @@unique([chapterId, sequenceOrder])
  @@index([chapterId])
}

model UserVideoProgress {
  id               String      @id @default(cuid())
  userId           String
  user             Parent      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId          String
  video            VideoLesson @relation(fields: [videoId], references: [id], onDelete: Cascade)
  watchTimeSeconds Float       @default(0)
  maxWatchedTime   Float       @default(0)
  isCompleted      Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
}

model ChapterQuiz {
  id        String   @id @default(cuid())
  chapterId String   @unique
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  /** MCQ array: { id, prompt, options: string[], correctIndex: number } */
  questions Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserQuizResult {
  id              String   @id @default(cuid())
  userId          String
  user            Parent   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId       String
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  scorePercentage Float
  isPassed        Boolean  @default(false)
  answers         Json?
  attemptedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
}

model UserChapterProgress {
  id        String       @id @default(cuid())
  userId    String
  user      Parent       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status    ModuleStatus @default(LOCKED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
}

model SkillNode {
  id            String             @id @default(cuid())
  subjectId     String
  subject       SubjectCatalog     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name          String
  /** Axis label for radar chart; empty if not a radar skill */
  radarAxis     String             @default("")
  parentSkillId String?
  parent        SkillNode?         @relation("SkillTree", fields: [parentSkillId], references: [id], onDelete: SetNull)
  children      SkillNode[]        @relation("SkillTree")
  sortOrder     Int                @default(0)
  /** Maps module subjectCategory / lesson tags → this skill */
  skillTags     String[]           @default([])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  mastery       UserSkillMastery[]

  @@index([subjectId, sortOrder])
  @@index([parentSkillId])
}

model UserSkillMastery {
  id              String    @id @default(cuid())
  userId          String
  user            Parent    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId         String
  skill           SkillNode @relation(fields: [skillId], references: [id], onDelete: Cascade)
  totalAttempts   Int       @default(0)
  correctAttempts Int       @default(0)
  masteryScore    Float     @default(0)
  lastEvaluatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model UserGoal {
  id          String    @id @default(cuid())
  userId      String
  user        Parent    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  dueDate     DateTime?
  skillId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, isCompleted])
}

// ─── Teacher Dashboard ───────────────────────────────────────────────

enum TextbookStatus {
  UPLOADED
  VERIFYING
  INDEXED
  FAILED
}

enum DoubtStatus {
  PENDING
  AI_DRAFT
  APPROVED
  OVERRIDDEN
  REJECTED
}

enum TopicVideoStatus {
  none
  generating
  pending_review
  published
  rejected
  failed
}

enum OrgType {
  school
  tutor_center
}

enum AppRole {
  org_admin
  center_admin
  teacher
  parent
  student
}

enum PlanType {
  free
  teacher_free
  teacher_pro
  tutor_center_pro
  school_enterprise
  family_plan
  parent_free
  student_free
  student_pro
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
  inactive
}

enum BillingInterval {
  monthly
  yearly
}

model Teacher {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  name           String?
  schoolName     String?
  subjectFocus   String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  planType       PlanType      @default(teacher_free)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  textbooks      Textbook[]
  doubts         StudentDoubt[]
  classBatches   ClassBatch[]
  platformUsers  PlatformUser[]

  @@index([organizationId])
}

model Textbook {
  id                String         @id @default(cuid())
  teacherId         String
  teacher           Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  organizationId    String?
  organization      Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  isGlobal          Boolean        @default(false)
  title             String
  fileName          String
  fileSizeBytes     Int            @default(0)
  subject           String         @default("Science")
  gradeLabel        String         @default("Class 9")
  status            TextbookStatus @default(UPLOADED)
  pageCount         Int?
  indexedChunkCount Int            @default(0)
  storagePath       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  chapters          TeacherChapter[]
  ragChunks         RagChunk[]

  @@index([teacherId])
  @@index([organizationId])
}

model RagChunk {
  id           String   @id @default(cuid())
  textbookId   String
  textbook     Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  content      String
  pageHint     String?
  sequence     Int      @default(0)
  sourceType   String   @default("textbook")
  subtopicId   String?
  attachmentId String?
  attachment   SubtopicAttachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  embedding    Json?
  createdAt    DateTime @default(now())

  @@index([textbookId])
  @@index([subtopicId])
  @@index([sourceType])
  @@index([attachmentId])
}

model TeacherChapter {
  id               String   @id @default(cuid())
  textbookId       String
  textbook         Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  title            String
  sequenceOrder    Int
  summary          String   @default("")
  classProgressPct Int      @default(0)
  studentCount     Int      @default(0)
  completedCount   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  subtopics        TeacherSubtopic[]
  doubts           StudentDoubt[]

  @@index([textbookId])
  @@unique([textbookId, sequenceOrder])
}

model TeacherSubtopic {
  id                  String           @id @default(cuid())
  chapterId           String
  chapter             TeacherChapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  code                String
  title               String
  sequenceOrder       Int
  hasVideoExplainer   Boolean          @default(false)
  hasGamifiedActivity Boolean          @default(false)
  videoTitle          String?
  activityTitle       String?
  /** Persisted teacher selection for video generation template */
  videoTemplateId     String?
  /** Persisted teacher selection for activity generation template */
  activityTemplateId  String?
  videoUrl            String?
  /** AI video generation workflow */
  videoStatus         TopicVideoStatus @default(none)
  videoProgress       Int              @default(0)
  /** retrieving | scripting | tts | rendering | done | error */
  videoJobStage       String?
  videoError          String?
  generatedVideoUrl   String?
  videoAudioUrl       String?
  videoScript         String?
  animationCuesJson   Json?
  videoManifestJson   Json?
  videoJobStartedAt   DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  doubts              StudentDoubt[]
  activities          Activity[]
  attachments         SubtopicAttachment[]

  @@index([chapterId])
  @@unique([chapterId, sequenceOrder])
}

model SubtopicAttachment {
  id                String          @id @default(cuid())
  subtopicId        String
  subtopic          TeacherSubtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  teacherId         String
  fileName          String
  mimeType          String
  fileSizeBytes     Int             @default(0)
  storagePath       String
  publicUrl         String
  kind              String
  extractedText     String          @default("")
  indexedChunkCount Int             @default(0)
  createdAt         DateTime        @default(now())
  ragChunks         RagChunk[]

  @@index([subtopicId])
}

model Activity {
  id            String          @id @default(cuid())
  subtopicId    String
  subtopic      TeacherSubtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  chapterId     String
  type          String          @default("tom_jerry_cinematic")
  title         String
  /** Cinematic Tom & Jerry script: setup, question_loop, outcomes. */
  content       Json?
  questionsJson Json
  totalXp       Int             @default(250)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([subtopicId])
  @@index([chapterId])
}

model StudentDoubt {
  id                  String          @id @default(cuid())
  teacherId           String
  teacher             Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  chapterId           String
  chapter             TeacherChapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  subtopicId          String?
  subtopic            TeacherSubtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  studentName         String
  question            String
  status              DoubtStatus     @default(PENDING)
  aiAnswerText        String?
  aiGroundedSources   String[]        @default([])
  aiConfidence        Float           @default(0)
  teacherOverrideText String?
  pointsAwarded       Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([teacherId, status])
  @@index([chapterId])
}

// ─── Multi-tenant SaaS identity ──────────────────────────────────────

model Organization {
  id                     String             @id @default(cuid())
  name                   String
  type                   OrgType
  logoUrl                String?
  planType               PlanType
  maxLicenses            Int                @default(50)
  adminUserId            String?            @unique
  adminUser              PlatformUser?      @relation("OrgAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  subscriptionStatus     SubscriptionStatus @default(active)
  billingInterval        BillingInterval?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  primaryColor           String             @default("#5B46BA")
  primaryHoverColor      String             @default("#4A3799")
  accentColor            String             @default("#0D9488")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  members                PlatformUser[]     @relation("OrgMembers")
  teachers               Teacher[]
  classBatches           ClassBatch[]
  textbooks              Textbook[]
}

model PlatformUser {
  id                     String             @id @default(cuid())
  email                  String             @unique
  passwordHash           String
  name                   String?
  role                   AppRole
  planType               PlanType           @default(free)
  organizationId         String?
  organization           Organization?      @relation("OrgMembers", fields: [organizationId], references: [id], onDelete: SetNull)
  adminOfOrg             Organization?      @relation("OrgAdmin")
  teacherId              String?
  teacher                Teacher?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  parentProfileId        String?
  parentProfile          Parent?            @relation(fields: [parentProfileId], references: [id], onDelete: SetNull)
  parentLinkCode         String?            @unique
  aiDoubtsUsedToday      Int                @default(0)
  aiDoubtsResetAt        DateTime?
  subscriptionStatus     SubscriptionStatus @default(active)
  billingInterval        BillingInterval?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  parentLinksAsParent    StudentParentLink[] @relation("ParentLinks")
  parentLinksAsStudent   StudentParentLink[] @relation("StudentLinks")
  enrollments            ClassEnrollment[]

  @@index([organizationId])
  @@index([role])
  @@index([teacherId])
  @@index([parentProfileId])
}

model ClassBatch {
  id             String            @id @default(cuid())
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  teacherId      String
  teacher        Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name           String
  inviteCode     String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  enrollments    ClassEnrollment[]

  @@index([organizationId])
  @@index([teacherId])
}

model StudentParentLink {
  id            String       @id @default(cuid())
  parentUserId  String
  parentUser    PlatformUser @relation("ParentLinks", fields: [parentUserId], references: [id], onDelete: Cascade)
  studentUserId String
  studentUser   PlatformUser @relation("StudentLinks", fields: [studentUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([parentUserId, studentUserId])
  @@index([parentUserId])
  @@index([studentUserId])
}

model ClassEnrollment {
  id            String       @id @default(cuid())
  studentUserId String
  studentUser   PlatformUser @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  classBatchId  String
  classBatch    ClassBatch   @relation(fields: [classBatchId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([studentUserId, classBatchId])
  @@index([studentUserId])
  @@index([classBatchId])
}
